<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">

        <shape>

            <solid android:color="@color/colorVerdeClaro">

            </solid>

            <stroke android:width="@dimen/_1sdp"
                android:color="@color/colorNegro">

            </stroke>

            <corners
                android:topLeftRadius="@dimen/_7sdp"
                android:topRightRadius="@dimen/_7sdp"
                android:bottomLeftRadius="@dimen/_7sdp"
                android:bottomRightRadius="@dimen/_7sdp"

                >

            </corners>
        </shape>


    </item>

    <item>

        <shape>
            <stroke android:width="@dimen/_1sdp"
                android:color="@color/colorNegro">

            </stroke>

            <solid android:color="@color/colorBlanco">

            </solid>

            <corners android:topLeftRadius="@dimen/_7sdp"
                android:topRightRadius="@dimen/_7sdp"
                android:bottomLeftRadius="@dimen/_7sdp"
                android:bottomRightRadius="@dimen/_7sdp"

                >

            </corners>

        </shape>
    </item>
</selector>