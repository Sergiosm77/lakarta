<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">

    <TextView
        android:id="@+id/textView5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryDark"
        android:padding="@dimen/_10sdp"
        android:text="@string/alta_usuario"
        android:textAlignment="center"
        android:textColor="@color/colorBlanco"
        android:textSize="@dimen/texto_negrita"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />




    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/botones"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView5">




        <ScrollView
            android:id="@+id/scroll_alta_user"
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/fondo_avatares"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/padding2"
                    android:orientation="horizontal"
                    android:gravity="center"
                    >

                    <androidx.cardview.widget.CardView
                        android:id="@+id/fondo_avatar_chico"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_10sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        app:cardCornerRadius="@dimen/_40sdp">

                        <ImageView
                            android:id="@+id/chico"
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="@dimen/_80sdp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/boy" />

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/fondo_avatar_chica"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_10sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        app:cardCornerRadius="@dimen/_40sdp">

                        <ImageView
                            android:id="@+id/chica"
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="@dimen/_80sdp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/girl" />


                    </androidx.cardview.widget.CardView>


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/caja_registro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_11sdp"
                    android:layout_marginStart="@dimen/padding2"
                    android:layout_marginEnd="@dimen/padding0"
                    android:layout_marginBottom="@dimen/padding0"
                    android:text="@string/nombre_usuario">

                </TextView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_marginStart="@dimen/padding2"
                    android:layout_marginEnd="@dimen/padding2"
                    android:layout_marginBottom="@dimen/padding2"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/icono_nombre"
                        android:layout_width="@dimen/icono_redondo_peq"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"
                        android:src="@drawable/delete"/>


                    <EditText
                        android:id="@+id/nombre"
                        style="@style/cajas_login"
                        android:backgroundTint="@color/colorRosa2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:maxLength="30"

                        android:inputType="text"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:paddingStart="@dimen/padding2"
                        android:textSize="@dimen/texto_normal"
                        android:textColor="@color/colorNegro"/>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:background="@color/colorGris"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_11sdp"
                    android:layout_marginTop="@dimen/padding2"
                    android:layout_marginStart="@dimen/padding2"
                    android:layout_marginEnd="@dimen/padding0"
                    android:layout_marginBottom="@dimen/padding0"
                    android:text="email">

                </TextView>

                  <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_marginStart="@dimen/padding2"
                    android:layout_marginEnd="@dimen/padding2"
                    android:layout_marginBottom="@dimen/padding2"
                    android:orientation="horizontal">

                     <ImageView
                         android:id="@+id/icono_email"
                         android:layout_width="@dimen/icono_redondo_peq"
                         android:layout_height="wrap_content"
                         android:layout_weight="0"
                         android:src="@drawable/delete"/>

                <EditText
                    android:id="@+id/email"
                    style="@style/cajas_login"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:maxLength="40"
                    android:backgroundTint="@color/colorRosa2"
                    android:inputType="textEmailAddress"
                    android:paddingStart="@dimen/padding2"
                    android:textSize="@dimen/texto_normal"
                    android:textColor="@color/colorNegro"/>

                  </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:background="@color/colorGris"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_11sdp"
                    android:layout_marginTop="@dimen/padding2"
                    android:layout_marginStart="@dimen/padding2"
                    android:layout_marginEnd="@dimen/padding0"
                    android:layout_marginBottom="@dimen/padding0"
                    android:text="@string/contrasena_usuario">

                </TextView>

                  <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_marginStart="@dimen/padding2"
                    android:layout_marginEnd="@dimen/padding2"
                    android:layout_marginBottom="@dimen/padding2"
                    android:orientation="horizontal">

                     <ImageView
                         android:id="@+id/icono_contra"
                         android:layout_width="@dimen/icono_redondo_peq"
                         android:layout_height="wrap_content"
                         android:layout_weight="0"
                         android:src="@drawable/delete"/>

                <EditText
                    android:id="@+id/contra"
                    style="@style/cajas_login"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:maxLength="30"
                    android:backgroundTint="@color/colorRosa2"
                    android:inputType="textPassword"
                    android:paddingStart="@dimen/padding2"
                    android:textSize="@dimen/texto_normal"
                    android:textColor="@color/colorNegro"/>

                  </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:background="@color/colorGris"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_11sdp"
                    android:layout_marginTop="@dimen/padding2"
                    android:layout_marginStart="@dimen/padding2"
                    android:layout_marginEnd="@dimen/padding0"
                    android:layout_marginBottom="@dimen/padding0"
                    android:text="@string/contrasena_usuario_repetir">

                </TextView>

                  <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_marginStart="@dimen/padding2"
                    android:layout_marginEnd="@dimen/padding2"
                    android:layout_marginBottom="@dimen/padding2"
                    android:orientation="horizontal">

                     <ImageView
                         android:id="@+id/icono_contra2"
                         android:layout_width="@dimen/icono_redondo_peq"
                         android:layout_height="wrap_content"
                         android:layout_weight="0"
                         android:src="@drawable/delete"/>

                      <EditText
                          android:id="@+id/contra2"
                          style="@style/cajas_login"
                          android:layout_marginStart="@dimen/_5sdp"
                          android:layout_width="match_parent"
                          android:layout_height="match_parent"
                          android:layout_weight="1"
                          android:maxLength="30"
                          android:backgroundTint="@color/colorRosa2"
                          android:inputType="textPassword"
                          android:paddingStart="@dimen/padding2"
                          android:textColor="@color/colorNegro"
                          android:textSize="@dimen/texto_normal" />
                  </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:background="@color/colorGris"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_30sdp"
                        android:gravity="center_vertical"
                        android:layout_marginStart="@dimen/padding2"
                        android:layout_marginEnd="@dimen/padding2"
                        android:layout_marginBottom="@dimen/_30sdp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/icono_politica"
                            android:layout_width="@dimen/icono_redondo_peq"
                            android:layout_height="wrap_content"
                            android:src="@drawable/delete"/>

                        <TextView
                            android:id="@+id/leer_politica"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                           android:layout_marginStart="@dimen/_5sdp"
                            android:textSize="@dimen/_11sdp"
                            android:textStyle="bold"
                            android:textColor="@color/colorRosa1"
                            android:text="@string/leer_y_aceptar_politica"/>

                    </LinearLayout>

                </LinearLayout>



                <LinearLayout
                    android:id="@+id/caja_codigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/padding2"
                    android:layout_marginEnd="@dimen/padding2"
                    android:layout_marginBottom="@dimen/padding2"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_11sdp"
                        android:layout_marginTop="@dimen/padding2"
                        android:layout_marginStart="@dimen/padding2"
                        android:textColor="@color/colorNegro"
                        android:layout_marginEnd="@dimen/padding2"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:text="@string/codigo_verificar">

                    </TextView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_10sdp"
                        android:textColor="@color/colorPrimaryDark"
                        android:layout_marginStart="@dimen/padding2"
                        android:layout_marginEnd="@dimen/padding2"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:text="@string/codigo_verificar_2">

                    </TextView>



                    <EditText
                        android:id="@+id/codigo"
                        style="@style/cajas_login"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_30sdp"
                        android:gravity="center"
                        android:maxLength="10"
                        android:backgroundTint="@color/colorRosa2"
                        android:inputType="text"
                        android:paddingStart="@dimen/padding2"
                        android:textColor="@color/colorNegro"
                        android:textSize="@dimen/texto_grande" />
                </LinearLayout>

            </LinearLayout>





        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/botones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"

        android:background="@color/colorPrimaryDark"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/registrar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_11sdp"
            android:background="?selectableItemBackground"
            android:gravity="center"
            android:layout_weight="1"
            android:padding="@dimen/_8sdp"
            android:text="@string/enviar"
            android:textColor="@color/colorRosa2"/>

        <TextView
            android:id="@+id/volver"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_11sdp"
            android:background="?selectableItemBackground"
            android:gravity="center"
            android:layout_weight="1"
            android:padding="@dimen/_8sdp"
            android:text="@string/volver"
            android:textColor="@color/colorRosa2"/>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>