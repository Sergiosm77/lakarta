<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:animateLayoutChanges="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ProgressBar
        android:id="@+id/barraprogreso_usuario"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/pantalla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimaryDark"
                android:padding="@dimen/_10sdp"
                android:text="@string/configura_usuarios"
                android:textAlignment="center"
                android:textColor="@color/colorBlanco"
                android:textSize="@dimen/texto_negrita" />


            <ScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/padding2">

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/padding2"
                        android:layout_marginBottom="@dimen/padding2"
                        android:textColor="@color/colorRosa3"
                        android:text="@string/pregunta_mostrar_coment"/>

                    <RadioGroup
                        android:id="@+id/grupo_permitir"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <RadioButton
                            android:id="@+id/radioButton0"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/_11sdp"
                            android:text="@string/mens_permitir" />

                        <RadioButton
                            android:id="@+id/radioButton1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/_11sdp"
                            android:text="@string/mens_no_permitir" />


                    </RadioGroup>



                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:layout_marginTop="@dimen/padding2"
                        android:background="@color/colorGris"/>

                    <LinearLayout
                        android:id="@+id/caja_dsede_donde"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">



                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/padding2"
                        android:layout_marginBottom="@dimen/padding2"
                        android:textColor="@color/colorRosa3"
                        android:text="@string/pregunta_desde_donde"/>

                    <RadioGroup
                        android:id="@+id/grupo_desde_donde"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <RadioButton
                            android:id="@+id/radioButton2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/_11sdp"
                            android:text="@string/mens_todas" />

                        <RadioButton
                            android:id="@+id/radioButton3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/_11sdp"
                            android:text="@string/mens_cerca" />

                        <RadioButton
                            android:id="@+id/radioButton4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/_11sdp"
                            android:text="@string/mens_elige_distancia" />

                    </RadioGroup>

                    <EditText
                        android:id="@+id/cantidad_km"
                        style="@style/cajas_login"
                        android:backgroundTint="@color/colorRosa2"
                        android:layout_width="@dimen/_50sdp"
                        android:layout_height="wrap_content"
                        android:maxLength="2"
                        android:textAlignment="center"
                        android:inputType="number"
                        android:layout_marginStart="@dimen/_100sdp"
                        android:textSize="@dimen/texto_normal"
                        android:ems="10"
                        android:text="10"
                        android:textColor="@color/colorNegro"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:layout_marginTop="@dimen/padding2"
                        android:background="@color/colorGris"/>

                    </LinearLayout>


                </LinearLayout>
            </ScrollView>

        </LinearLayout>



    <LinearLayout
        android:id="@+id/botones_menu1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryDark"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/enviar_cambios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_11sdp"
            android:layout_weight="1"
            android:background="?selectableItemBackground"
            android:padding="@dimen/_10sdp"
            android:text="@string/guardar"
            android:textAlignment="center"
            android:textColor="@color/colorRosa2"/>

        <TextView
            android:id="@+id/salir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_11sdp"
            android:layout_weight="1"
            android:background="?selectableItemBackground"
            android:padding="@dimen/_10sdp"
            android:text="@string/volver"
            android:textAlignment="center"
            android:textColor="@color/colorRosa2"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_emergente1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="15dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>