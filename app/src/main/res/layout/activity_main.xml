<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >


    <ImageView
        android:id="@+id/logo_lakarta"
        android:layout_width="@dimen/altura_logo"
        android:layout_height="@dimen/altura_logo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.345"
        app:srcCompat="@drawable/logo" />

    <TextView
        android:id="@+id/reintentar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/texto_negrita"
        android:textColor="@color/colorRosa1"

        android:background="?selectableItemBackgroundBorderless"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/logo_lakarta"
        app:layout_constraintBottom_toTopOf="@id/cargando"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/reintentar" />

    <TextView
        android:id="@+id/nueva_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/_30sdp"
        android:paddingEnd="@dimen/_30sdp"
        style="@style/texto_negrita"
        android:textColor="@color/colorRosa1"

        android:background="?selectableItemBackgroundBorderless"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/reintentar"
        app:layout_constraintBottom_toTopOf="@id/barra_inicio"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/nueva_version" />

    <ProgressBar
        android:id="@+id/barra_inicio"
        style="?android:attr/progressBarStyle"
        android:progressBackgroundTint="@color/colorRosa1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo_lakarta" />

    <TextView
        android:id="@+id/cargando"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/_11sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:textAlignment="center"
        android:paddingStart="@dimen/_50sdp"
        android:paddingEnd="@dimen/_50sdp"
        app:layout_constraintTop_toBottomOf="@id/barra_inicio"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/cargando_datos">


    </TextView>

</androidx.constraintlayout.widget.ConstraintLayout>