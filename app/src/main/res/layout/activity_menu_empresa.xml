<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ProgressBar
        android:id="@+id/barraprogreso_usuario"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/pantalla_menu1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textView5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimaryDark"
                android:padding="@dimen/_10sdp"
                android:text="@string/menu_empresa"
                android:textAlignment="center"
                android:textColor="@color/colorBlanco"
                android:textSize="@dimen/_14sdp" />


            <ScrollView
                android:id="@+id/scroll_menu_usuario"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:padding="@dimen/padding2"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/usuario_nom_restaurante"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                android:padding="4dp"
                                android:layout_marginBottom="@dimen/padding2"
                                android:textAlignment="textStart"
                                android:textColor="@color/colorNegro"
                                android:textSize="20sp"
                                android:text="comercio"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/contenedor_logo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0"
                                    android:layout_gravity="center"
                                    android:layout_marginEnd="5dp"
                                    app:cardCornerRadius="@dimen/icono_redondo2_radio">

                                    <ImageView
                                        android:id="@+id/logo_usuario"
                                        android:layout_width="@dimen/icono_redondo2"
                                        android:layout_height="@dimen/icono_redondo2"
                                        android:background="?selectableItemBackground"
                                        android:scaleType="centerCrop"
                                        tools:srcCompat="@drawable/user" />

                                </androidx.cardview.widget.CardView>

                                <LinearLayout
                                    android:id="@+id/estado_empresa"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/usuario_nom_usuario"
                                        style="@style/texto_negrita"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/_12sdp"
                                        android:padding="@dimen/_3sdp"
                                        android:minLines="1"
                                        android:text="usuario"
                                        />

                                    <TextView
                                        android:id="@+id/estado"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        style="@style/boton1"
                                        android:paddingStart="@dimen/padding2"
                                        android:paddingEnd="@dimen/padding2"
                                        android:textAlignment="center"
                                        android:layout_marginEnd="@dimen/_10sdp"
                                        android:maxLines="2"
                                        android:text="estado"
                                        android:textColor="@color/colorBlanco" />
                                    <TextView
                                        android:id="@+id/actualizando"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        style="@style/boton1"
                                        android:layout_marginTop="@dimen/_3sdp"
                                        android:paddingStart="@dimen/padding2"
                                        android:paddingEnd="@dimen/padding2"
                                        android:textAlignment="center"
                                        android:layout_marginEnd="@dimen/_10sdp"
                                        android:maxLines="2"
                                        android:text="estado"
                                        android:textColor="@color/colorBlanco" />


                                </LinearLayout>

                                <TextView
                                    android:id="@+id/cerrar_ses_empresa"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="?selectableItemBackground"
                                    android:layout_weight="0"
                                    style="@style/texto_negrita"
                                    android:textSize="@dimen/_12sdp"
                                    android:textColor="@color/colorRosa3"
                                    android:padding="@dimen/padding0"
                                    android:text="@string/boton_cierra_usuario"/>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">


                                <TextView

                                    android:id="@+id/contrato_hasta"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:layout_marginStart="@dimen/_5sdp"
                                    android:textAlignment="textStart"
                                    android:textSize="@dimen/_11sdp"
                                    android:text="Contrato hasta:"/>

                                <TextView

                                    android:id="@+id/fecha_fin"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:layout_marginStart="@dimen/_5sdp"
                                    android:textAlignment="textStart"
                                    android:textSize="@dimen/_11sdp"
                                    android:text="fecha"/>

                            </LinearLayout>

                            <TextView

                                android:id="@+id/cuenta_caducada"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:layout_marginStart="@dimen/_5sdp"
                                android:textColor="@color/colorRojo"
                                android:textAlignment="textStart"
                                android:textStyle="bold"
                                android:textSize="@dimen/_12sdp"/>


                        </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/colorRosa3" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/_10sdp"
                            android:textColor="@color/colorNegro"
                            android:layout_marginStart="@dimen/padding2"
                            android:padding="@dimen/padding0"
                            android:layout_gravity="start"
                            android:text="@string/imagen_principal"/>

                        <ImageView
                            android:id="@+id/imagen_usuario"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/altura_imagen_restaurante"
                            android:layout_weight="1"
                            android:background="?selectableItemBackground"
                            android:scaleType="centerCrop"

                            />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_7sdp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingTop="@dimen/_5sdp"
                            android:paddingBottom="@dimen/_5sdp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/_3sdp"
                                android:text="@string/telefono_empresa"
                                android:textStyle="bold"
                                android:textColor="@color/colorNegro"
                                android:textSize="@dimen/_10sdp" />

                            <TextView
                                android:id="@+id/usuario_telefono"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_12sdp"
                                android:paddingStart="@dimen/_10sdp"
                                android:text="telefono"
                                android:textColor="@color/colorNegro" />


                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:layout_marginBottom="@dimen/_3sdp"
                                android:text="@string/tipo_de_comida"
                                android:textStyle="bold"
                                android:textColor="@color/colorNegro"
                                android:textSize="@dimen/_10sdp" />


                            <TextView
                                android:id="@+id/usuario_tipo_comida"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_11sdp"
                                android:lineSpacingExtra="@dimen/_3sdp"
                                android:paddingStart="@dimen/padding2"
                                android:text="tipo de comida"
                                android:textColor="@color/colorNegro" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/padding2"
                                android:layout_marginBottom="@dimen/_3sdp"
                                android:textColor="@color/colorNegro"
                                android:textStyle="bold"
                                android:text="@string/descripcion"
                                android:textSize="@dimen/_10sdp"/>


                            <TextView
                                android:id="@+id/usuario_detalle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_11sdp"
                                android:maxLines="4"
                                android:paddingStart="@dimen/padding2"
                                android:lineSpacingExtra="@dimen/_3sdp"
                                android:text="describe"
                                android:textColor="@color/colorNegro" />

                            <TextView
                                android:id="@+id/ver_mas_detalle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_10sdp"
                                android:maxLines="4"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:layout_marginStart="@dimen/_20sdp"
                                android:text="@string/ver_mas_info"
                                android:textColor="@color/colorVerde" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/padding2"
                                android:layout_marginBottom="@dimen/_3sdp"
                                android:textColor="@color/colorNegro"
                                android:textStyle="bold"
                                android:text="@string/los_tags"
                                android:textSize="@dimen/_10sdp"/>

                            <TextView
                                android:id="@+id/usuario_tags"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_11sdp"
                                android:lineSpacingExtra="@dimen/_3sdp"
                                android:maxLines="4"
                                android:paddingStart="@dimen/padding2"
                                android:text="tags"
                                android:textColor="@color/colorNegro" />


                        </LinearLayout>



                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/colorRosa3" />

                    <LinearLayout
                        android:id="@+id/edita_datos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="?selectableItemBackground"
                        android:padding="@dimen/padding2"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:scaleType="centerCrop"
                            app:srcCompat="@drawable/edit"
                            app:tint="@color/colorRosa3"/>


                    <TextView

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/texto_negrita"
                        android:textColor="@color/colorRosa3"
                        android:textSize="@dimen/_12sdp"
                        android:text="@string/edita_datos_empresa"
                        android:layout_gravity="center"/>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/colorRosa3" />

                     <LinearLayout
                         android:id="@+id/modificar_karta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="?selectableItemBackground"
                        android:padding="@dimen/padding2"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:scaleType="centerCrop"
                            app:srcCompat="@drawable/esmenu"
                            app:tint="@color/colorRosa3"/>

                        <TextView

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/texto_negrita"
                            android:textColor="@color/colorRosa3"
                            android:textSize="@dimen/_12sdp"
                            android:text="@string/modificar_karta"
                            android:layout_gravity="center"/>

                     </LinearLayout>

                     <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/colorRosa3" />

                    <LinearLayout
                        android:id="@+id/personaliza_colores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="?selectableItemBackground"
                        android:padding="@dimen/padding2"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:scaleType="centerCrop"
                            app:srcCompat="@drawable/publi_04_colores"
                            app:tint="@color/colorRosa3"/>

                        <TextView

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/texto_negrita"
                            android:textColor="@color/colorRosa3"
                            android:textSize="@dimen/_12sdp"
                            android:layout_gravity="center"
                            android:text="@string/personaliza_colores"
                         />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/colorRosa3" />

                    <LinearLayout
                        android:id="@+id/ver_previo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="?selectableItemBackground"
                        android:padding="@dimen/padding2"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:scaleType="centerCrop"
                            app:srcCompat="@drawable/publi_01_todo"
                            app:tint="@color/colorRosa3"/>

                    <TextView

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/texto_negrita"
                        android:textColor="@color/colorRosa3"
                        android:textSize="@dimen/_12sdp"
                        android:layout_gravity="center"
                        android:text="@string/previo_karta"
                        />

                    </LinearLayout>

                   <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/colorRosa3" />

                    <LinearLayout
                        android:id="@+id/configura_usuarios"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="?selectableItemBackground"
                        android:padding="@dimen/padding2"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:scaleType="centerCrop"
                            app:srcCompat="@drawable/user"
                            app:tint="@color/colorRosa3"/>

                    <TextView

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/texto_negrita"
                        android:textColor="@color/colorRosa3"
                        android:textSize="@dimen/_12sdp"
                        android:layout_gravity="center"
                        android:text="@string/configura_usuarios"
                        />

                    </LinearLayout>


                  <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/colorRosa3" />

                    <LinearLayout
                        android:id="@+id/cambio_pass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="?selectableItemBackground"
                        android:padding="@dimen/padding2"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:scaleType="centerCrop"
                            app:srcCompat="@drawable/icon_login"
                            app:tint="@color/colorRosa3"/>

                    <TextView

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/texto_negrita"
                        android:textColor="@color/colorRosa3"
                        android:textSize="@dimen/_12sdp"
                        android:layout_gravity="center"
                        android:text="@string/cambiar_contrasena"
                        />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/colorRosa3" />

                    <LinearLayout

                        android:id="@+id/crear_pdf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="?selectableItemBackground"
                        android:padding="@dimen/padding2"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:scaleType="centerCrop"
                            app:srcCompat="@drawable/qr_code"
                            app:tint="@color/colorRosa3"/>

                    <TextView

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/texto_negrita"
                        android:textColor="@color/colorRosa3"
                        android:textSize="@dimen/_12sdp"
                        android:layout_gravity="center"
                        android:text="@string/crear_pdf"
                        />

                    </LinearLayout>

                     <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/colorRosa3" />

                    <LinearLayout
                        android:id="@+id/contacto_lakarta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="?selectableItemBackground"
                        android:padding="@dimen/padding2"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:scaleType="centerCrop"
                            app:srcCompat="@drawable/logo" />

                    <TextView

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/texto_negrita"
                        android:textColor="@color/colorRosa3"
                        android:textSize="@dimen/_12sdp"
                        android:layout_gravity="center"
                        android:text="@string/contacto_lakarta"
                        />

                    </LinearLayout>

                    <View
                        android:id="@+id/view"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/altura_imagen_texto" />



                </LinearLayout>
            </ScrollView>

        </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryDark"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <TextView
            android:id="@+id/salir_usuario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_11sdp"
            android:layout_weight="1"
            android:background="?selectableItemBackground"
            android:padding="@dimen/_8sdp"
            android:text="@string/salir"
            android:textAlignment="center"
            android:textColor="@color/colorRosa2"/>
    </LinearLayout>

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">

    </eightbitlab.com.blurview.BlurView>



    <LinearLayout
        android:id="@+id/layout_emergente1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/_5sdp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>