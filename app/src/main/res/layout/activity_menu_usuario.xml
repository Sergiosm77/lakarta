<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ProgressBar
        android:id="@+id/barraprogreso_usuario"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />



        <LinearLayout
            android:id="@+id/pantalla_menu1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textView5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimaryDark"
                android:padding="@dimen/_10sdp"
                android:text="@string/menu_usuario"
                android:textAlignment="center"
                android:textColor="@color/colorBlanco"
                android:textSize="@dimen/_14sdp" />


            <ScrollView
                android:id="@+id/scroll_menu_usuario"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/fondo_avatar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_10sdp"
                            android:layout_marginEnd="@dimen/_10sdp"
                            app:cardElevation="0dp"
                            app:cardCornerRadius="@dimen/_35sdp">

                            <ImageView
                                android:id="@+id/avatar"
                                android:layout_width="@dimen/_70sdp"
                                android:layout_height="@dimen/_70sdp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/user" />

                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/usuario_nombre"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                android:padding="4dp"
                                android:layout_marginBottom="@dimen/padding2"
                                android:textAlignment="textStart"
                                android:textColor="@color/colorNegro"
                                android:textSize="@dimen/texto_negrita"
                                android:text="fdsfsdfsdf"/>

                            <TextView
                                android:id="@+id/usuario_email"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="3"
                                android:padding="4dp"
                                android:layout_marginBottom="@dimen/padding2"
                                android:textAlignment="textStart"
                                android:textColor="@color/colorNegro"
                                android:textSize="@dimen/texto_normal"
                                android:text="fdsfsdfsdf"/>

                        </LinearLayout>




                    </LinearLayout>

                    <TextView
                        android:id="@+id/cerrar_ses_usuario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="right"
                        android:background="?selectableItemBackground"
                        style="@style/texto_negrita"
                        android:textColor="@color/colorRosa3"
                        android:paddingEnd="@dimen/padding2"
                        android:paddingBottom="@dimen/padding2"
                        android:text="@string/boton_cierra_usuario"/>



                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/colorRosa3"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="textStart"
                        android:layout_margin="@dimen/padding2"
                        android:textColor="@color/colorGrisTexto"
                        android:textSize="@dimen/texto_pequeno"
                        android:text="@string/datos_confindenciales"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/colorRosa3"/>

                     <LinearLayout
                         android:id="@+id/cambia_alergenos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="?selectableItemBackground"
                        android:padding="@dimen/padding2"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:scaleType="centerCrop"
                            app:srcCompat="@drawable/publi_03_alergeno"
                            app:tint="@color/colorRosa3"/>

                    <TextView
                        android:id="@+id/usuario_alergenos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="textStart"
                        android:textSize="@dimen/_12sdp"
                        style="@style/texto_negrita"
                        android:textColor="@color/colorRosa3"
                        android:text="@string/mis_alergenos"/>


                </LinearLayout>

                    <GridLayout
                        android:id="@+id/contenedor_misalergenos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/padding2"
                        android:layout_marginEnd="@dimen/padding2"
                        android:columnCount="3"
                        android:orientation="horizontal"
                        android:padding="@dimen/padding0">

                    </GridLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/colorRosa3"/>

                     <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="?selectableItemBackground"
                        android:padding="@dimen/padding2"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:scaleType="centerCrop"
                            app:srcCompat="@drawable/icon_login"
                            app:tint="@color/colorRosa3"/>

                    <TextView
                        android:id="@+id/cambio_pass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?selectableItemBackground"
                        style="@style/texto_negrita"
                        android:textSize="@dimen/_12sdp"
                        android:textColor="@color/colorRosa3"
                        android:text="@string/cambiar_contrasena"/>

                     </LinearLayout>

                </LinearLayout>
            </ScrollView>

        </LinearLayout>



    <LinearLayout
        android:id="@+id/botones_menu1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryDark"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <TextView
            android:id="@+id/salir_usuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_11sdp"
            android:background="?selectableItemBackground"
            android:padding="10dp"
            android:text="@string/salir"
            android:textAlignment="center"
            android:textColor="@color/colorRosa2"/>
    </LinearLayout>

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">

    </eightbitlab.com.blurview.BlurView>



    <LinearLayout
        android:id="@+id/layout_emergente1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="15dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>