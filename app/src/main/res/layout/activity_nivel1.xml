<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ProgressBar
        android:id="@+id/barraprogreso_usuario"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />



        <LinearLayout
            android:id="@+id/pantalla_menu1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textView5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimaryDark"
                android:padding="@dimen/_10sdp"
                android:text="@string/modificar_karta"
                android:textAlignment="center"
                android:textColor="@color/colorBlanco"
                android:textSize="@dimen/_14sdp"/>


            <ScrollView
                android:id="@+id/scroll_menu_usuario"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/contenedor_categorias"
                        android:layout_width="match_parent"

                        android:layout_height="match_parent"
                        android:animateLayoutChanges="true"
                        android:orientation="vertical">

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nueva_categoria"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="20dp"
                        android:background="?selectableItemBackground"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imageView2"
                            android:layout_width="@dimen/circulo_boton_edit"
                            android:layout_height="@dimen/circulo_boton_edit"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/add" />

                        <TextView
                            android:id="@+id/textView4"
                            style="@style/texto_botones"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/padding2"
                            android:layout_weight="1"
                            android:text="@string/nueva_categoria" />
                    </LinearLayout>

                    <View
                        android:id="@+id/view"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/altura_imagen_texto" />

                </LinearLayout>
            </ScrollView>

        </LinearLayout>



    <LinearLayout
        android:id="@+id/botones_menu1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryDark"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/enviar_cambio_orden1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_11sdp"
            android:layout_weight="1"
            android:background="?selectableItemBackground"
            android:padding="@dimen/_8sdp"
            android:text="@string/cambiar_orden"
            android:textAlignment="center"
            android:textColor="@color/colorRosa2"/>

        <TextView
            android:id="@+id/salir_usuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_11sdp"
            android:layout_weight="1"
            android:background="?selectableItemBackground"
            android:padding="@dimen/_8sdp"
            android:text="@string/volver"
            android:textAlignment="center"
            android:textColor="@color/colorRosa2"/>
    </LinearLayout>

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">

    </eightbitlab.com.blurview.BlurView>



    <LinearLayout
        android:id="@+id/layout_emergente1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="15dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>