<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/alergeno"
        android:layout_width="@dimen/icono_redondo_peq"
        android:layout_height="@dimen/icono_redondo_peq"
         />

    <TextView
        android:id="@+id/alergeno_nombre"
        android:textSize="@dimen/texto_pequeno"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:layout_marginEnd="@dimen/padding0"
        android:layout_marginStart="@dimen/padding0" />




</LinearLayout>