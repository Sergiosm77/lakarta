<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/_3sdp"
    >

    <LinearLayout
        android:id="@+id/contenedor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding0"
            android:layout_marginTop="@dimen/padding2"
            android:layout_marginEnd="@dimen/padding0"
            android:layout_marginBottom="@dimen/_5sdp"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/_7sdp">

            <LinearLayout
                android:id="@+id/fondo_detalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/imagen_categoria"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_120sdp"
                        app:layout_constraintTop_toTopOf="parent"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/categoria_icono" />

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        app:layout_constraintTop_toTopOf="parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/nombre_categoria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:maxLines="3"
                            android:padding="@dimen/_5sdp"
                            android:shadowColor="@color/colorNegro"
                            android:shadowRadius="20"
                            android:text="nombre"
                            android:textColor="@color/colorBlanco"
                            android:textSize="@dimen/_18sdp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/precio_categoria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/_5sdp"
                            android:layout_weight="0"
                            android:fontFamily="sans-serif"
                            android:layout_gravity="top"
                            android:paddingStart="@dimen/padding0"
                            android:paddingEnd="@dimen/padding2"
                            android:shadowColor="@color/colorNegro"
                            android:shadowRadius="20"
                            android:text="0€"
                            android:textColor="@color/colorBlanco"
                            android:textSize="@dimen/_18sdp"
                            android:textStyle="bold" />

                    </LinearLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>




                <TextView
                    android:id="@+id/detalle_categoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/padding2"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:maxLines="3"
                    android:minLines="1"
                    android:text="detalle"
                    android:textColor="@color/colorNegro"
                    android:textSize="@dimen/_11sdp" />

            </LinearLayout>


        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="@dimen/ancho_arriba_abajo"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/mover_arriba"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?selectableItemBackground"
                app:srcCompat="@drawable/up_down" />

            <ImageView
                android:id="@+id/mover_abajo"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?selectableItemBackground"
                android:rotation="180"
                app:srcCompat="@drawable/up_down" />
        </LinearLayout>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/no_mostrar_imagen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_60sdp"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardElevation="@dimen/_10sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    <TextView

        android:layout_width="match_parent"
        android:layout_height="@dimen/_20sdp"
        android:textColor="@color/colorRojo"
        android:gravity="center"
        android:paddingStart="@dimen/_10sdp"
        android:paddingEnd="@dimen/_10sdp"
        android:textSize="@dimen/_10sdp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/contenedor"
        android:text="@string/no_mostrar_imagen"/>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/contenedor_cardview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_40sdp"
        android:layout_marginBottom="@dimen/_40sdp"
        app:cardCornerRadius="@dimen/circulo_boton_edit_radio"
        app:cardElevation="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/edita_categoria"
            android:layout_width="@dimen/circulo_boton_edit"
            android:layout_height="@dimen/circulo_boton_edit"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="@dimen/_10sdp"
            app:srcCompat="@drawable/pencil" />
    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>