<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:id="@+id/barra_plato"
    >





    <androidx.cardview.widget.CardView
        android:id="@+id/contenedor_cardview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="0dp"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        android:layout_marginTop="@dimen/padding2"
        android:layout_marginBottom="@dimen/padding0"
        app:cardCornerRadius="@dimen/_7sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">



        <ImageView
            android:id="@+id/imagen_plato_destacada"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_120sdp"

            android:scaleType="centerCrop"
            app:srcCompat="@drawable/no_photo" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/producto_agotado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elevation="@dimen/_10sdp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:textSize="@dimen/_20sdp"
                    android:textColor="@color/colorNegro"
                    android:shadowColor="@color/colorBlanco"
                    android:shadowRadius="20"
                    android:textStyle="bold"
                    android:rotation="-20"
                    android:text="AGOTADO"/>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/_100sdp"
        android:background="?selectableItemBackground"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/fondo_detalle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/_100sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/fondo_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:padding="@dimen/padding0"
                android:gravity="center_vertical"
                android:background="@color/colorGris"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/nombre_plato"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="3"
                    android:layout_marginStart="@dimen/padding0"
                    android:text="nombre"
                    android:textSize="@dimen/texto_normal"
                    android:textColor="@color/colorBlanco" />

                <TextView
                    android:id="@+id/precio_plato"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_11sdp"
                    android:layout_weight="0"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:textColor="@color/colorBlanco"
                    android:fontFamily="sans-serif-light"

                    android:text="0€" />
            </LinearLayout>

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginBottom="@dimen/padding0"
                android:orientation="horizontal"
                >


                <TextView
                    android:id="@+id/detalle_plato"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:layout_marginEnd="@dimen/_3sdp"
                    android:layout_marginBottom="@dimen/_3sdp"
                    android:layout_weight="1"

                    android:fontFamily="sans-serif-light"
                    android:lineSpacingExtra="@dimen/_3sdp"
                    android:maxLines="6"
                    android:minLines="3"
                    android:text="detalle"
                    android:textColor="@color/colorNegro"
                    android:textSize="@dimen/texto_pequeno" />

                <ImageView
                    android:id="@+id/alerta_alergeno"
                    android:layout_width="@dimen/circulo_boton_edit"
                    android:layout_height="@dimen/circulo_boton_edit"
                    android:minHeight="@dimen/altura_imagen_icono"
                    android:padding="@dimen/padding0"

                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/alert" />

                <TextView
                    android:id="@+id/cantidad_platos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|top"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:layout_weight="0"
                    android:background="@drawable/redondo_inf"
                    android:backgroundTint="@color/colorVerde"
                    android:fontFamily="@font/andika"
                    android:paddingStart="@dimen/_5sdp"
                    android:paddingEnd="@dimen/_5sdp"
                    android:text=""
                    android:textColor="@color/colorBlanco"
                    android:textSize="@dimen/texto_pequeno" />



            </LinearLayout>

            <LinearLayout
                android:id="@+id/contenedor_alergenos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:paddingStart="@dimen/_3sdp"
                android:paddingBottom="@dimen/_3sdp"
                android:orientation="horizontal"
                >

            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/imagen_plato_normal"
            android:layout_width="@dimen/altura_imagen_icono"
            android:layout_height="match_parent"

            android:scaleType="centerCrop"
            app:srcCompat="@drawable/no_photo" />

    </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        </androidx.cardview.widget.CardView>


</LinearLayout>