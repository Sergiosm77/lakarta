<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/linearLayout9"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/contenedor_cardview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding0"

            android:layout_marginTop="@dimen/padding2"
            android:layout_marginBottom="@dimen/padding2"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/_7sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/fondo_detalle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/fondo_nombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"
                        android:background="@color/colorGris"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/padding0">

                        <TextView
                            android:id="@+id/nombre_plato"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/_12sdp"
                            android:layout_marginStart="@dimen/padding0"
                            android:layout_weight="1"
                            android:maxLines="3"
                            android:text="nombre"
                            android:textColor="@color/colorBlanco" />

                        <TextView
                            android:id="@+id/precio_plato"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/_12sdp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:layout_weight="0"
                            android:fontFamily="sans-serif-light"
                            android:text="0€"

                            android:textColor="@color/colorBlanco" />
                    </LinearLayout>

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/padding0"
                        android:layout_weight="1"
                        android:orientation="horizontal">


                        <TextView
                            android:id="@+id/detalle_plato"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/_15sdp"
                            android:layout_marginTop="@dimen/_3sdp"
                            android:layout_marginEnd="@dimen/_3sdp"
                            android:layout_weight="1"
                            android:lineSpacingExtra="@dimen/_3sdp"
                            android:fontFamily="sans-serif-light"
                            android:maxLines="6"
                            android:minLines="3"
                            android:text="detalle"
                            android:textColor="@color/colorNegro"
                            android:textSize="@dimen/texto_pequeno" />


                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/contenedor_alergenos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"
                        android:paddingStart="@dimen/_3sdp"
                        android:paddingBottom="@dimen/_3sdp"
                        android:orientation="horizontal"
                        >

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_4sdp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/no_mostrar_imagen"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/colorRojo"
                            android:textStyle="bold"
                            android:text="@string/no_mostrar_imagen"/>

                        <TextView
                            android:id="@+id/es_destacado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/colorRojo"
                            android:textStyle="bold"
                            android:text="@string/destacar"/>

                        <TextView
                            android:id="@+id/es_agotado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/colorRojo"
                            android:textStyle="bold"
                            android:text="@string/agotado"/>

                        <TextView
                            android:id="@+id/es_menu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/colorRojo"
                            android:textStyle="bold"
                            android:text="@string/es_menu"/>

                    </LinearLayout>



                </LinearLayout>



                <ImageView
                    android:id="@+id/imagen_plato"
                    android:layout_width="@dimen/altura_imagen_icono"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/altura_imagen_icono"
                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/no_photo" />

            </LinearLayout>





        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="@dimen/_30sdp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/mover_arriba"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?selectableItemBackground"
                app:srcCompat="@drawable/up_down" />

            <ImageView
                android:id="@+id/mover_abajo"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?selectableItemBackground"
                android:rotation="180"
                app:srcCompat="@drawable/up_down" />
        </LinearLayout>

    </LinearLayout>

    <androidx.cardview.widget.CardView

        android:id="@+id/cardView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_100sdp"
        android:layout_marginTop="@dimen/_30sdp"
        app:cardCornerRadius="@dimen/circulo_boton_edit_radio"
        app:cardElevation="@dimen/_10sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/linearLayout9">

        <ImageView
            android:id="@+id/edita_nivel2"
            android:layout_width="@dimen/circulo_boton_edit"
            android:layout_height="@dimen/circulo_boton_edit"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="@dimen/_10sdp"
            app:srcCompat="@drawable/pencil" />
    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>