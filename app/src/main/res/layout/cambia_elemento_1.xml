<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
  android:orientation="vertical">


        <androidx.cardview.widget.CardView
            android:id="@+id/elementos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:cardCornerRadius="@dimen/_7sdp"
            android:background="@color/colorBlanco"
            >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"

                    >

                        <LinearLayout
                            android:id="@+id/color_fondo_detalle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/colorBlanco"
                            android:layout_weight="1"
                            android:orientation="vertical">

                                <LinearLayout
                                    android:id="@+id/color_fondo_nombre"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0"
                                    android:background="@color/colorGris"
                                    android:orientation="horizontal"
                                    android:padding="@dimen/padding0">

                                        <TextView
                                            android:id="@+id/color_nombre"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:textSize="@dimen/_11sdp"
                                            android:layout_marginStart="@dimen/padding0"
                                            android:maxLines="3"
                                            android:text="@string/texto_prueba_nombre"
                                            android:textColor="@color/colorBlanco" />

                                        <TextView
                                            android:id="@+id/color_precio"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/_11sdp"
                                            android:layout_weight="0"
                                            android:layout_gravity="end"
                                            android:layout_marginStart="@dimen/_10sdp"
                                            android:layout_marginEnd="5dp"
                                            android:fontFamily="sans-serif-light"
                                            android:text="10€"

                                            android:textColor="@color/colorBlanco" />
                                </LinearLayout>


                                <TextView
                                    android:id="@+id/color_detalle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:textSize="@dimen/_10sdp"
                                    android:layout_marginStart="15dp"
                                    android:layout_marginTop="@dimen/padding2"
                                    android:layout_marginBottom="@dimen/padding2"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-light"
                                    android:gravity="center_vertical"
                                    android:text="@string/texto_prueba_detalle"
                                    android:textColor="@color/colorNegro"/>


                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imagen_plato"
                            android:layout_width="@dimen/altura_imagen_icono"
                            android:layout_height="@dimen/altura_imagen_icono"
                            android:layout_weight="0"
                            android:scaleType="centerCrop"
                            android:src="@drawable/plato_standard" />

                </LinearLayout>

        </androidx.cardview.widget.CardView>



</LinearLayout>