<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:id="@+id/portada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:cardCornerRadius="@dimen/_7sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView5">

                <LinearLayout
                    android:id="@+id/fondo_detalle_portada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/colorBlanco"
                    android:orientation="vertical">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                                <ImageView
                                    android:id="@+id/imagen_portada"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/_70sdp"

                                    android:scaleType="centerCrop"
                                    app:srcCompat="@drawable/categoria_icono"
                                    app:layout_constraintTop_toTopOf="parent"/>

                                <TextView
                                    android:id="@+id/nombre_categoria"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-black"
                                    android:gravity="center"
                                    android:maxLines="3"
                                    android:paddingStart="@dimen/_10sdp"
                                    android:paddingTop="@dimen/_5sdp"
                                    android:paddingEnd="@dimen/_10sdp"
                                    android:paddingBottom="@dimen/_5sdp"
                                    android:shadowColor="@color/colorNegro"
                                    android:shadowRadius="20"
                                    android:text="Nombre categoría"
                                    android:textColor="@color/colorBlanco"
                                    android:textSize="@dimen/_16sdp"
                                    android:textStyle="bold"
                                    app:layout_constraintTop_toTopOf="parent" />


                        </androidx.constraintlayout.widget.ConstraintLayout>


                        <TextView
                            android:id="@+id/detalle_categoria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/_11sdp"
                            android:elevation="5dp"
                            android:gravity="center"
                            android:maxLines="3"
                            android:minLines="1"
                            android:layout_margin="@dimen/_5sdp"
                            android:text="Detalle categoría"
                            android:textColor="@color/colorNegro"/>

                </LinearLayout>


        </androidx.cardview.widget.CardView>


</LinearLayout>