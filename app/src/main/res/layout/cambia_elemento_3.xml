<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/fondo_elemento3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/colorBlanco"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:padding="@dimen/padding_pequeno">

                                <LinearLayout

                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/nombre_elemento3"
                                            style="@style/texto_grande_negrita"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="sans-serif-condensed-light"
                                            android:maxLines="2"
                                            android:text="@string/nombre_plato"
                                            android:textAlignment="textEnd"
                                            android:textColor="@color/colorRosa3" />

                                        <TextView
                                            android:id="@+id/detalle_elemento3"
                                            style="@style/texto_normal"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="sans-serif-condensed-light"
                                            android:maxLines="2"
                                            android:text="@string/detalle"
                                            android:textAlignment="textEnd"
                                            android:textColor="@color/colorRosa3" />


                                </LinearLayout>

                                <TextView
                                    android:id="@+id/precio_elemento3"
                                    style="@style/texto_normal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_margin="@dimen/padding2"
                                    android:layout_weight="0"
                                    android:fontFamily="sans-serif-condensed-light"
                                    android:maxLines="2"
                                    android:text="10€"
                                    android:textColor="@color/colorRosa3" />

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/contenedor_cardview"
                                    android:layout_width="@dimen/icono_redondo"
                                    android:layout_height="@dimen/icono_redondo"
                                    android:layout_gravity="center"
                                    android:layout_marginEnd="5dp"
                                    app:cardCornerRadius="@dimen/icono_redondo_radio">

                                        <ImageView
                                            android:id="@+id/imagen_criterio"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:background="?selectableItemBackground"
                                            android:src="@drawable/plato_icono"
                                            android:scaleType="centerCrop" />

                                </androidx.cardview.widget.CardView>


                        </LinearLayout>




</LinearLayout>