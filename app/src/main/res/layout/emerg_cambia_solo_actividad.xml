<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/padding0"
        app:cardCornerRadius="@dimen/_7sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/cabecera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/titulo_cambionivel"
                    style="@style/texto_negrita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:elevation="3dp"
                    android:padding="5dp"
                    android:text="@string/modificar_actividad_empresa"
                    android:textAlignment="center" />



            </LinearLayout>

            <LinearLayout
                android:id="@+id/abajo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
               >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:paddingStart="@dimen/_45sdp"
                    android:paddingEnd="@dimen/_45sdp"
                    android:textSize="@dimen/_10sdp"
                    android:text="@string/pon_en_linea"/>


                <LinearLayout
                    android:id="@+id/ficha_online"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:paddingStart="@dimen/padding2">

                    <ImageView

                        style="@style/icono_pequeno"
                        app:srcCompat="@drawable/online" />

                    <TextView
                        android:id="@+id/estado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/boton1"
                        android:paddingStart="@dimen/padding2"
                        android:paddingEnd="@dimen/padding2"
                        android:paddingTop="@dimen/_3sdp"
                        android:paddingBottom="@dimen/_3sdp"
                        android:textAlignment="center"
                        android:layout_marginStart="@dimen/_15sdp"
                        android:layout_marginEnd="@dimen/_30sdp"
                        android:textSize="@dimen/_12sdp"
                        android:maxLines="2"
                        android:text="estado"
                        android:textColor="@color/colorBlanco" />


                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:paddingStart="@dimen/_45sdp"
                    android:paddingEnd="@dimen/_45sdp"
                    android:textSize="@dimen/_10sdp"
                    android:text="@string/pon_actualizando"/>


                <LinearLayout
                    android:id="@+id/ficha_actualizando"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:paddingStart="@dimen/padding2">

                    <ImageView

                        style="@style/icono_pequeno"
                        app:srcCompat="@drawable/updating" />

                    <TextView
                        android:id="@+id/actualizando"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/boton1"
                        android:paddingStart="@dimen/padding2"
                        android:paddingEnd="@dimen/padding2"
                        android:paddingTop="@dimen/_3sdp"
                        android:paddingBottom="@dimen/_3sdp"
                        android:textAlignment="center"
                        android:layout_marginStart="@dimen/_15sdp"
                        android:layout_marginEnd="@dimen/_30sdp"
                        android:textSize="@dimen/_12sdp"
                        android:maxLines="2"
                        android:text="estado"
                        android:textColor="@color/colorBlanco" />


                </LinearLayout>


                <LinearLayout
                    android:id="@+id/linearLayout15"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/modificar"
                        style="@style/texto_botones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?selectableItemBackground"
                        android:padding="@dimen/_10sdp"
                        android:text="@string/guardar"
                        android:textAlignment="center"/>


                    <TextView
                        android:id="@+id/nomodificar"
                        style="@style/texto_botones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?selectableItemBackground"
                        android:padding="10dp"
                        android:text="@string/cancelar"
                        android:textAlignment="center"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


    </androidx.cardview.widget.CardView>


</LinearLayout>