<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="@dimen/_5sdp"
    android:paddingBottom="@dimen/_5sdp"
    android:orientation="vertical"
    android:animateLayoutChanges="true">

       <androidx.cardview.widget.CardView
            android:id="@+id/contenedor_plato"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="@dimen/_7sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/redondo_sup"
        android:backgroundTint="@color/colorRosa4">

        <TextView
            android:id="@+id/nombre_menu"
            style="@style/texto_grande_negrita"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_5sdp"
            android:text="nombre menú"
            />




        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detalle_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_11sdp"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:maxLines="4"
                android:minLines="1"
                android:text="describe"
                android:gravity="start"
                android:textColor="@color/colorNegro" />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/caja_hacer_pedido_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp"
            android:paddingBottom="@dimen/_10sdp"
            >


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:gravity="center"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/precio_menu"
                    android:textColor="@color/colorNegro"
                    android:textSize="@dimen/_10sdp"/>


                <TextView
                    android:id="@+id/precio_menu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/colorNegro"
                    android:textSize="@dimen/_11sdp"/>

            </LinearLayout>

             <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.7"
                android:gravity="center"
                android:orientation="vertical">

                 <TextView
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:text="@string/total"
                     android:textStyle="bold"
                     android:textColor="@color/colorNegro"
                     android:textSize="@dimen/_10sdp"/>

            <TextView
                android:id="@+id/total_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textStyle="bold"
                android:text="0"
                android:textColor="@color/colorNegro"
                android:textSize="@dimen/_11sdp"/>

             </LinearLayout>

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/elige_cuantos_menus"
                    android:textColor="@color/colorGris"
                    android:textSize="@dimen/_8sdp"/>

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/cantidad_menu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/colorNegro"
                        android:textSize="@dimen/_30sdp"/>

                <TextView
                    android:id="@+id/menu_menos"
                    style="@style/boton1"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:text="-"
                    android:textColor="@color/colorNegro"
                    android:textSize="@dimen/_20sdp" />

                <TextView
                    android:id="@+id/menu_mas"
                    style="@style/boton1"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/colorNegro"
                    android:textSize="@dimen/_20sdp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


    </LinearLayout>

    <ScrollView
        android:id="@+id/contenedormenus_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">


    <LinearLayout
        android:id="@+id/contenedor_menus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:paddingBottom="@dimen/_60sdp"
        android:paddingTop="@dimen/_15sdp"
        android:orientation="vertical">


    </LinearLayout>

    </ScrollView>

    <TextView
        android:id="@+id/ayuda_plato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/_11sdp"
        android:background="@color/colorNaranja"
        android:padding="4dp"
        android:gravity="center"
        android:textColor="@color/colorNegro"
        android:text="help">

    </TextView>



    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/redondo_inf"
        android:backgroundTint="@color/colorRosa4"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/elimina_menu"
            style="@style/texto_negrita"
            android:background="?selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_weight="1"
            android:textAlignment="center"
            android:paddingBottom="6dp"
            android:paddingTop="6dp"
            android:text="@string/no_guardar_menu"/>

        <TextView
            android:id="@+id/acepta_menu"
            style="@style/texto_negrita"
            android:background="?selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:paddingTop="6dp"
            android:layout_weight="1"
            android:textAlignment="center"
            android:text="@string/aceptar" />
    </LinearLayout>






</LinearLayout>

       </androidx.cardview.widget.CardView>

</LinearLayout>



