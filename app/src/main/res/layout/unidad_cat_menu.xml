<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="@dimen/_10sdp"
    android:paddingBottom="@dimen/_10sdp"

    >

    <androidx.cardview.widget.CardView

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        app:cardElevation="0dp"
        android:translationY="@dimen/_10sdp"
        app:cardCornerRadius="@dimen/_50sdp">

        <ImageView
            android:id="@+id/imagen_nivel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_imagen_icono"

            android:scaleType="centerCrop"
            app:srcCompat="@drawable/no_photo"/>



    </androidx.cardview.widget.CardView>


                <LinearLayout
                    android:id="@+id/ficha_editamenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingEnd="@dimen/padding2"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <androidx.cardview.widget.CardView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_5sdp"
                            app:cardElevation="0dp"
                            app:cardCornerRadius="@dimen/_20sdp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="@dimen/_20sdp"
                                android:paddingEnd="@dimen/_20sdp"
                                android:paddingBottom="@dimen/_3sdp"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/nombre_criterio"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="nombre"
                                    android:textStyle="bold"
                                    android:maxLines="2"
                                    android:textColor="@color/colorNegro"
                                    android:textSize="@dimen/texto_negrita"/>


                                <TextView
                                    android:id="@+id/cantidad_criterio"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/_9sdp"
                                    android:textColor="@color/colorRosa3"
                                    android:text="cantidad"/>


                            </LinearLayout>




                        </androidx.cardview.widget.CardView>


                        <TextView
                            android:id="@+id/detalle_criterio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_15sdp"
                            android:layout_marginEnd="@dimen/_10sdp"
                            android:layout_marginBottom="@dimen/_5sdp"
                            android:lineSpacingExtra="@dimen/_3sdp"
                            android:gravity="center"
                            android:text="detalle"
                            android:textColor="@color/colorNegro"
                            android:textSize="@dimen/_11sdp"
                            android:textStyle="italic" />

                    </LinearLayout>

                </LinearLayout>




                <LinearLayout
                    android:id="@+id/contenedor_elementos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:orientation="vertical"
                    >


                </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#80000000"/>



</LinearLayout>