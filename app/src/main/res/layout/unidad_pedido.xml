<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_marginTop="@dimen/_10sdp"
    android:background="@drawable/redondo_tot_blanco">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_10sdp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pedido_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_11sdp"
            android:layout_weight="0.9"
            android:minLines="1"
            android:maxLines="3"
            android:text="nombre" />

        <TextView
            android:id="@+id/pedido_precio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_11sdp"
            android:layout_weight="1.6"
            android:text="0"
            android:textAlignment="viewEnd" />

        <TextView
            android:id="@+id/pedido_cantidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_11sdp"
            android:layout_weight="1.7"
            android:text="0"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/pedido_total_plato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_11sdp"
            android:maxLines="1"
            android:layout_weight="1.6"
            android:text="0"
            android:textAlignment="textEnd" />



    </LinearLayout>
    <LinearLayout
        android:id="@+id/contenedor_pedidos_nivel4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#80000000"/>
</LinearLayout>