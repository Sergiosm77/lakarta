<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"
    >

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginBottom="@dimen/_5sdp"
        app:cardElevation="0dp"
        app:cardCornerRadius="@dimen/_7sdp">




    <LinearLayout
        android:id="@+id/unidad_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorGrisSuave2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?selectableItemBackground"
            android:layout_marginStart="@dimen/padding2"
            android:paddingTop="@dimen/padding0"
            android:paddingBottom="@dimen/padding0"
            android:gravity="center_vertical"
            android:orientation="vertical">



            <TextView
                android:id="@+id/nombre_plato_menu"
                style="@style/texto_normal"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:maxLines="2"
                android:minLines="1"
                android:text="nombre"/>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="horizontal">



                <TextView
                    style="@style/texto_pequeno"
                    android:textColor="@color/colorGrisTexto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/suplemento"/>

                <TextView
                    android:id="@+id/precio_plato_menu"
                    style="@style/texto_normal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:text="0"/>

                <TextView
                    style="@style/texto_normal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:text="€"/>

            </LinearLayout>


            <TextView
                style="@style/texto_pequeno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorGrisTexto"
                android:layout_marginEnd="@dimen/padding2"
                android:layout_marginTop="5dp"
                android:maxLines="2"
                android:text="@string/detalle"/>

            <TextView
                android:id="@+id/detalle_plato_menu"
                style="@style/texto_normal"
                android:textColor="@color/colorNegro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/padding2"
                android:layout_marginBottom="@dimen/_5sdp"
                android:lineSpacingExtra="@dimen/_3sdp"
                android:maxLines="2"
                android:text="detalles"/>


            <LinearLayout
                android:id="@+id/contenedor_alergenos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_20sdp"
                android:paddingBottom="@dimen/_2sdp"
                android:orientation="horizontal">



            </LinearLayout>

            <TextView
                android:id="@+id/agotado"
                style="@style/texto_negrita"
                android:textColor="@color/colorRojo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/agotado"/>

            <TextView
                android:id="@+id/no_mostrar_imagen"
                style="@style/texto_negrita"
                android:textColor="@color/colorRojo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_mostrar_imagen"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_5sdp"
            android:orientation="vertical">




            <androidx.cardview.widget.CardView
                android:id="@+id/contenedor_img_plato"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/icono_redondo2_radio">


                <ImageView
                    android:id="@+id/imagen_plato"
                    android:layout_width="@dimen/icono_redondo2"
                    android:layout_height="@dimen/icono_redondo2"
                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/no_photo" />


            </androidx.cardview.widget.CardView>



        </LinearLayout>


    </LinearLayout>

    </androidx.cardview.widget.CardView>


</LinearLayout>