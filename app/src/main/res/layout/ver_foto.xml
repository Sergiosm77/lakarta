<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:animateLayoutChanges="true"
    >

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/_10sdp"
        android:layout_margin="@dimen/_15sdp">




    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        >

        <TextView
            android:id="@+id/detalle_categoria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/colorGris"
            android:padding="@dimen/_5sdp"
            android:gravity="center"
            android:elevation="5dp"
            android:maxLines="3"
            android:minLines="1"
            android:text="detalle"
            android:textColor="@color/colorBlanco"
            android:textSize="@dimen/_11sdp"
            app:layout_constraintBottom_toBottomOf="@+id/ver_foto"
            app:layout_constraintEnd_toEndOf="@+id/ver_foto"
            app:layout_constraintStart_toStartOf="@+id/ver_foto" />

        <TextView
            android:id="@+id/nombre_categoria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/colorGris"
            android:elevation="5dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxLines="3"
            android:minLines="1"
            android:padding="@dimen/_5sdp"
            android:text="nombre"
            android:textColor="@color/colorBlanco"
            android:textSize="@dimen/texto_negrita"
            android:textStyle="bold"

            app:layout_constraintEnd_toEndOf="@+id/ver_foto"
            app:layout_constraintStart_toStartOf="@+id/ver_foto"
            app:layout_constraintTop_toTopOf="@+id/ver_foto" />


            <ImageView
                android:id="@+id/ver_foto"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_350sdp"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/categoria_icono"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>



    </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>



</LinearLayout>